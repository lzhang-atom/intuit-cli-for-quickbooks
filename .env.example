# Get your credentials from the Intuit Developer portal:
# 1. Go to https://developer.intuit.com/app/developer/dashboard
# 2. Create an app (or select an existing one) → choose "QuickBooks Online and Payments"
# 3. Go to Keys & credentials
#
# Sandbox and Production have separate Client IDs and Secrets.
# Copy each from the corresponding tab in Keys & credentials.
#
# Tip: Run `intuit auth configure --env sandbox` or `intuit auth configure --env production`
# to set these up interactively.

# Sandbox (development/testing)
INTUIT_SANDBOX_CLIENT_ID=your_sandbox_client_id
INTUIT_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret

# Production (live data — requires app review and approval from Intuit)
INTUIT_PROD_CLIENT_ID=your_production_client_id
INTUIT_PROD_CLIENT_SECRET=your_production_client_secret
